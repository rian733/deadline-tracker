{
  "manifest_version": 3,
  "name": "Deadline Tracker",
  "version": "0.4.0",
  "description": "Collects assignment due dates into one color-coded list. All data stays on your computer.",
  "permissions": [
    "storage",
    "sidePanel",
    "alarms",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "https://classroom.google.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Deadline Tracker",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
